{
  "name": "blinkist-downloader",
  "version": "1.0.0",
  "description": "Scrape Blinkist and download saved books (text and audio)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonbiro/blinkist-downloader.git"
  },
  "author": "Ralf Vogler",
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "bin": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx ./index.ts",
    "export:mp3": "node ./scripts/export-mp3.mjs",
    "test:mp3": "node --test ./test/export-mp3.test.mjs",
    "test:core": "node --import tsx --test ./test/book-files.test.ts",
    "test": "npm run test:core && npm run test:mp3",
    "check": "tsc --noEmit -p tsconfig.json",
    "doctor": "node ./scripts/doctor.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fingerprint-injector": "^2.1.51",
    "lowdb": "^7.0.1",
    "playwright-chromium": "^1.44.0",
    "tsx": "^4.11.0"
  },
  "devDependencies": {
    "@tsconfig/node21": "^21.0.3",
    "@types/node": "^20.12.12",
    "typescript": "^5.9.3"
  }
}
