{
  "name": "blinkist-downloader",
  "version": "1.0.0",
  "description": "Scrape Blinkist and download saved books (text and audio)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonbiro/blinkist-downloader.git"
  },
  "author": "Ralf Vogler",
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "bin": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx ./index.ts",
    "export:mp3": "node ./scripts/export-audio.mjs --format mp3",
    "test:mp3": "node --test ./test/export-mp3.test.mjs",
    "test:core": "node --import tsx --test ./test/book-files.test.ts ./test/audio-capture.test.ts ./test/database.test.ts",
    "test": "npm run test:core && npm run test:inventory && npm run test:mp3 && npm run test:m4b",
    "check": "tsc --noEmit -p tsconfig.json",
    "doctor": "node ./scripts/doctor.mjs",
    "test:browser": "RUN_BROWSER_TESTS=1 node --import tsx --test ./test/audio-capture.browser.test.ts ./test/library-scan.browser.test.ts",
    "verify:library": "tsx ./scripts/verify-library.ts",
    "test:inventory": "node --test ./test/verify-library.test.mjs",
    "export:m4b": "node ./scripts/export-audio.mjs --format m4b",
    "export:both": "node ./scripts/export-audio.mjs --format both",
    "test:m4b": "node --test ./test/export-m4b.test.mjs",
    "start:camoufox": "node ./scripts/run-camoufox.mjs",
    "test:camoufox": "node ./scripts/run-camoufox.mjs --offline-tests"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fingerprint-injector": "^2.1.51",
    "lowdb": "^7.0.1",
    "playwright-chromium": "^1.44.0",
    "tsx": "^4.11.0"
  },
  "devDependencies": {
    "@tsconfig/node21": "^21.0.3",
    "@types/node": "^20.12.12",
    "typescript": "^5.9.3"
  }
}
